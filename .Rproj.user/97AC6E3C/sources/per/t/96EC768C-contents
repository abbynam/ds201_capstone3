# ════════════════════════════════════════════════════════════════════════════════
# PSY 304 — Reading diagnostic plots when ALL your predictors are CATEGORICAL
#
# The situation: predictors are groups (e.g. sex, race, condition), outcome is
# continuous. The diagnostic plots come out as VERTICAL STRIPES, not a cloud — one
# stripe per group combination. That LOOKS broken. Usually it isn't.
#
# This script builds TWO datasets with the SAME striped look:
#   SCENARIO A — striping is a harmless ARTIFACT; the model is fine.
#   SCENARIO B — striping HIDES a real violation (unequal variance between groups).
# The point: learn to tell them apart. Run top to bottom, one chunk at a time.
# ════════════════════════════════════════════════════════════════════════════════

####I AM SIMULATING DATA - YOU WONT RUN THIS ON YOUR OWN PROJECT####
# base R only — nothing to install
set.seed(304)

# Two categorical predictors, each with 2 levels -> 4 group combinations.
n <- 600
g1 <- factor(sample(c("Female","Male"), n, replace = TRUE))
g2 <- factor(sample(c("Treatment","Control"), n, replace = TRUE))

# group means (same for both scenarios): an additive effect of each predictor
mu <- 50 + 4*(g1=="Male") + 6*(g2=="Treatment")


# ════════════════════════════════════════════════════════════════════════════════
# SCENARIO A — EQUAL variance across groups (the striping is just an ARTIFACT)
# ════════════════════════════════════════════════════════════════════════════════

yA <- mu + rnorm(n, mean = 0, sd = 6)      # same sd in every group
dA <- data.frame(y = yA, g1, g2)

mA <- lm(y ~ g1 + g2, data = dA)

# LOOK: with 2x2 categorical predictors there are only 4 possible fitted values,
# so Residuals-vs-Fitted shows 4 vertical STRIPES. This is NORMAL. Read WITHIN each
# stripe: are the clouds about the same height, centered on 0, no fanning?
par(mfrow = c(2, 2)); plot(mA); par(mfrow = c(1, 1))

# THE CHECK that settles it — compare spread across groups (Levene-style).
# Base-R Levene via ANOVA on |residuals| by group; p > .05 = no evidence of unequal var.
dA$grp <- interaction(dA$g1, dA$g2)
summary(aov(abs(residuals(mA)) ~ dA$grp))   # SCENARIO A: expect NON-significant

# Cell sizes — make sure no group combination is tiny/unstable:
table(dA$g1, dA$g2)


# ════════════════════════════════════════════════════════════════════════════════
# SCENARIO B — UNEQUAL variance (striping HIDES a real violation)
# One group (Male & Treatment) is far more variable than the others.
# ════════════════════════════════════════════════════════════════════════════════
sdB <- ifelse(g1=="Male" & g2=="Treatment", 16, 5)   # one noisy group
yB  <- mu + rnorm(n, mean = 0, sd = sdB)
dB  <- data.frame(y = yB, g1, g2)

mB <- lm(y ~ g1 + g2, data = dB)

# LOOK: same 4 stripes — but now ONE stripe is visibly TALLER than the others, and
# Scale-Location trends up. THAT is real heteroscedasticity, not an artifact.
par(mfrow = c(2, 2)); plot(mB); par(mfrow = c(1, 1))

# THE SAME CHECK — now it should flag:
dB$grp <- interaction(dB$g1, dB$g2)
summary(aov(abs(residuals(mB)) ~ dB$grp))   # SCENARIO B: expect SIGNIFICANT

# Confirm by eye — spread of the outcome within each group:
aggregate(y ~ g1 + g2, data = dB, FUN = sd)


# ════════════════════════════════════════════════════════════════════════════════
# HOW TO READ STRIPED PLOTS — general rules of thumb
# ════════════════════════════════════════════════════════════════════════════════
# 1. STRIPES THEMSELVES ARE NOT A VIOLATION. Categorical predictors -> few distinct
#    fitted values -> vertical bands. Expected. Don't "fix" it.
# 2. Read WITHIN and ACROSS the stripes:
#      • each stripe centered on 0?                 -> linearity/fit OK
#      • stripes about the SAME height?             -> equal variance OK
#      • one stripe much taller / fanning?          -> real heteroscedasticity (Scenario B)
# 3. Q-Q plot: mild stair-stepping is fine; a hard shelf/ceiling means the OUTCOME is
#    bounded or skewed (a DIFFERENT problem — see the count-outcome demo).
# 4. CHECKS, not vibes:
#      • aov(abs(residuals(m)) ~ group)   -> unequal variance? (Levene-style)
#      • table(g1, g2)                    -> any tiny cells? (unstable estimate; ties
#                                            to the small-cell problem in intersectionality)
# 5. IF variance really is unequal: options in increasing effort —
#      • report it honestly as a limitation,
#      • use robust/sandwich SEs (lmtest::coeftest + sandwich::vcovHC),
#      • or Welch-style ANOVA (oneway.test) which doesn't assume equal variance.
#
# BIG-PICTURE QUESTION
#   Two categorical predictors on a continuous outcome is really a 2x2 ANOVA in
#   regression clothing. It's the same Outcome = Model + Error but different math
#   The actual answer is to run an ANOVA instead (Same math; different framing/story.)
# ════════════════════════════════════════════════════════════════════════════════


# Same formula, two functions:
mA   <- lm(y ~ g1 + g2, data = dA) # regression
aovA <- aov(y ~ g1 + g2, data = dA) # ANOVA

summary(mA)       # regression view: COEFFICIENTS (differences between group means)
summary(aovA)     # ANOVA view:      an F-TABLE (variance explained by each factor)

# They describe ONE model. The link:
#   • lm() intercept  = the reference-cell mean (Female, Control)
#   • lm() g1Male     = how much the mean shifts for Male  (a group-mean DIFFERENCE)
#   • lm() g2Treatment= how much the mean shifts for Treatment
# Confirm by computing the four group means directly:
aggregate(y ~ g1 + g2, data = dA, FUN = mean)
#   Female/Control ~ 50.3   <- matches the lm() intercept
#   Male/Control   ~ 54.1   <- intercept + g1Male  (50.3 + 4.1)
#   The regression coefficients ARE the ANOVA group-mean differences.

# And the overall model F is identical across the two:
#   lm():  F(2, 597) = 121.8   (bottom of summary(mA))
#   aov(): the same F, split into one row per factor (summary(aovA))


# ── STEP 7: THE INTERACTION — the question ANOVA framing makes natural ────────
# "Additive" (g1 + g2) assumes each factor's effect is the same regardless of the
# other. To ask whether the effect of one DEPENDS on the other, use  *  not  + :
mAx <- lm(y ~ g1 * g2, data = dA)       # same as aov(y ~ g1 * g2, data = dA)
summary(mAx)                            # look at the g1Male:g2Treatment row

# In this data the interaction is NOT significant (p ~ .69) -> the factors are
# additive here, and reporting that is a real finding. This is the SAME interaction
# idea from the intersectionality lecture: a 2x2 design is the simplest place to see
# a multiplicative (interaction) effect — or to confirm there isn't one.

# WHEN TO FRAME IT AS ANOVA vs REGRESSION (same math — pick the clearer story):
#   • comparing group means, 2x2 design, want an interaction test  -> ANOVA framing reads cleaner
#   • continuous predictors in the mix, or predicting/adjusting    -> regression framing
#   • unequal group variances (Scenario B)?  -> oneway.test() gives a Welch ANOVA
#     that doesn't assume equal variance:
oneway.test(y ~ interaction(g1, g2), data = dB)   # Welch; compare to the equal-var version

